+console.log('\nTest 6: Review Route Integration with analyzeSentiment');
+{
+  const sentimentModule = await import('../recommender/sentiment.js');
+  assert.equal(typeof sentimentModule.analyzeSentiment, 'function',
+    'sentiment.js must export analyzeSentiment for routes/reviews.js integration');
+  assert.strictEqual(sentimentModule.analyzeSentiment, sentimentModule.analyzeReviewSentiment,
+    'analyzeSentiment must be an exact alias for analyzeReviewSentiment');
+
+  // Verify that reviewsRoute uses analyzeSentiment dynamically
+  const { default: reviewsRoute } = await import('../routes/reviews.js');
+  const { default: Review } = await import('../models/Review.js');
+
+  // Helper to find route handler
+  function findRouteHandler(router, path, method) {
+    for (const layer of router.stack) {
+      if (layer.route && layer.route.path === path && layer.route.methods[method.toLowerCase()]) {
+        return layer.route.stack[layer.route.stack.length - 1].handle;
+      }
+    }
+    return null;
+  }
+
+  const postReviewHandler = findRouteHandler(reviewsRoute, '/books/:isbn/reviews', 'POST');
+  assert.equal(typeof postReviewHandler, 'function', 'POST /books/:isbn/reviews route handler must exist');
+
+  // Mock Review.findOneAndUpdate to capture saved sentiment
+  let capturedSentiment = null;
+  const originalFindOneAndUpdate = Review.findOneAndUpdate;
+  Review.findOneAndUpdate = async (filter, update) => {
+    capturedSentiment = update.$set.sentiment;
+    return { ...update.$set, _id: 'mock_review_123' };
+  };
+  const originalFind = Review.find;
+  Review.find = () => ({ lean: async () => [{ rating: 4 }] });
+
+  try {
+    const mockUser = {
+      _id: 'user_m2_test',
+      username: 'tester',
+      wantToRead: [],
+      currentlyReading: [],
+      read: [],
+      save: async () => {},
+    };
+
+    const req = {
+      params: { isbn: 'S1' },
+      body: {
+        rating: 4,
+        text: 'Not good, not exciting, and definitely not recommended.',
+      },
+      user: mockUser,
+      userId: 'user_m2_test',
+    };
+
+    const res = {
+      statusCode: 200,
+      body: null,
